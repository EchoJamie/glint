<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  产品标识见 sources/App/GlintIds.swift。
	  此处与 sources/App/GlintIds.swift 必须一致，`make check-ids` 会核对。
	  输入源 ID 一旦变更，系统内已注册的输入源会失效。
	-->
	<key>TISInputSourceID</key>
	<string>com.github.echojamie.inputmethod.Glint</string>

	<key>CFBundleIdentifier</key>
	<string>com.github.echojamie.inputmethod.Glint</string>
	<key>CFBundleExecutable</key>
	<string>Glint</string>
	<key>CFBundleName</key>
	<string>Glint</string>
	<key>CFBundleDisplayName</key>
	<string>Glint</string>
	<!-- Finder / 关于本机等处显示的图标，由 scripts/make-icons.py 生成。 -->
	<key>CFBundleIconFile</key>
	<string>GlintIcon</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<!-- 声明本包支持的平台。Xcode 构建时会自动写入，手写 Makefile 需显式声明；
	     参考实现鼠须管同样有此键。 -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- 输入法常驻但不进入 Dock 与菜单栏 -->
	<key>LSUIElement</key>
	<true/>
	<key>LSBackgroundOnly</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- 允许系统用中/英键或 Caps Lock 在 Glint 与拉丁输入源间切换 -->
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>

	<!-- IMK 服务连接名。连接名不变，避免改变已注册服务的身份。 -->
	<key>InputMethodConnectionName</key>
	<string>com.github.echojamie.inputmethod.Glint_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>Glint.GlintInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>Glint.GlintInputController</string>

	<!-- macOS 26.6.2 的 IMKServer 从此项决定是否向宿主发布 Touch Bar 候选。
	     缺省关闭；仅 updateCandidates 不会启用该通路。协议边界见 docs/troubleshooting.md。 -->
	<key>SendsTouchBarCandidatesToApp</key>
	<true/>

	<!--
	  只做简体，不做繁体。输入源 ID 仍保留 .Hans 后缀：
	  简体模式保留 .Hans 后缀，未来增加其他模式时无需更改已有 ID。
	  图标由 scripts/make-icons.py 生成。
	-->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.github.echojamie.inputmethod.Glint.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>com.github.echojamie.inputmethod.Glint.Hans</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>glint.pdf</string>
				<key>tsInputModeMenuIconFileKey</key>
				<string>glint.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>glint.pdf</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeKeyEquivalentModifiersKey</key>
				<integer>4608</integer>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smUnicodeScript</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.github.echojamie.inputmethod.Glint.Hans</string>
		</array>
	</dict>
</dict>
</plist>
