<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 0.1.0 保留已做实机输入验收的动态库配置。
	     打包脚本现在用同一 Apple Development 身份重签 librime 与三个插件；
	     旧注释称它们是 ad-hoc 签名并以此证明该豁免必需，已不成立。
	     删除豁免需要另行完成真实输入宿主中的插件加载回归。 -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- 输入法需要读写 ~/Library/Glint 与用户允许的 iCloud Drive 普通文件夹。 -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- 非沙盒应用使用 URLSession 按需下载公开输入方案，无需 network.client 沙盒 entitlement。 -->
</dict>
</plist>
